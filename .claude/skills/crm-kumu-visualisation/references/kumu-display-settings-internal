@controls {
  top-left {
    search {}

    filter {
      target: element;
      by: "type-display";
      as: dropdown;
      multiple: true;
      default: show-all;
      label: "filter by type";
    }

    filter {
      target: element;
      by: "mapping-consent";
      as: dropdown;
      multiple: true;
      default: show-all;
      label: "filter by consent for mapping";
    }

    showcase {
      target: element;
      by: "interactions-all";
      as: dropdown;
      multiple: true;
      default: select-none;
      mode: normal;
      label: "showcase by interaction";
    }
  }
}

@settings {
  template: stakeholder;
  element-shape: categorize("type-display");
  element-scale: scale("Size", 0.5, 3);
  element-color: categorize("type-display", #000000 "Person", #004488 "Community", #666666 "Project", #CC6677 "Funder", #332288 "Consortium", #DDCC77 "Academic institute", #117733 "Public sector / Government", #88CCEE "Intergovernmental organisation", #882255 "Non-profit", #44AA99 "Social enterprise", #999933 "Cooperative", #AA4499 "Private industry");
}
